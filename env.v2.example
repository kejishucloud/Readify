# Non-secret example. Copy to .env and replace values before public deployment.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SECRET_KEY=replace-with-random-key
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Optional isolated CosyVoice worker. Empty = device speech only.
READIFY_VOICE_WORKER_URL=
READIFY_VOICE_WORKER_TOKEN=
# Same token on worker host; keep private.
# READIFY_COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B
