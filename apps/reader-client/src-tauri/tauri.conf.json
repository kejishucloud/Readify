{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readify",
  "version": "0.1.0",
  "identifier": "com.kejishucloud.readify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Readify V2",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 460
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
